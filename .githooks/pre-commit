#!/bin/sh
# 提交前自动脱敏检查
# ------------------------------------------------------------
# 目的：防止把自身安全信息（凭据、本地路径、个人信息、项目专名）推上去。
#
# 安装：scripts/install-hooks.ps1  或  scripts/install-hooks.sh
#   （把 core.hooksPath 指到 .githooks，团队成员 clone 后跑一次即可）
#
# 绕过：git commit --no-verify
#   ⚠️ 只在你确认没有敏感内容、且清楚原因时使用。

# ⚠️ 为什么要 -ExecutionPolicy Bypass：
#   实测（2026-10-05）：实际生效策略是 RemoteSigned，
#   同一份未签名 ps1 在 C: 盘上能跑，在 F: 盘上会被按"来源不可信"拦下；
#   一旦被拦，rc=1 -> **每次提交都被拒**，而报错信息是执行策略而非命中的规则，
#   很难看出原因。显式 Bypass 是开发钩子的标准做法。
#
# 只检查本次**暂存**的文件 —— 保持提交速度
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

root=$(git rev-parse --show-toplevel)

# 依次尝试几个可能的位置：
#  - 包被安装在子目录时（agent-constraints/scripts/）
#  - 包就是仓库本身时（scripts/）
# 两个位置都试，是为了让同一个 hook 在"作为工具被安装"和"本仓库自身"两种情况下都能用
checker=""
for dir in "$root/agent-constraints/scripts" "$root/scripts"; do
    if [ -f "$dir/sanitize-check.ps1" ]; then checker="$dir/sanitize-check.ps1"; break; fi
    if [ -f "$dir/sanitize-check.sh" ];  then checker="$dir/sanitize-check.sh";  break; fi
done

if [ -z "$checker" ]; then
    echo "⚠️  找不到脱敏检查脚本，跳过（请先运行 scripts/install-hooks.*）" >&2
    exit 0
fi

case "$checker" in
    *.ps1)
        # ⚠️ 必须**逐个文件**传参：把多行文件名变量一次性交给 -Path，
        #    PowerShell 只会收到第一个，后面的文件就静默漏检了（实测踩过——
        #    一次 13 个文件的提交，hook 只报告检查了 1 个）。
        rc=0
        for f in $files; do
            if command -v pwsh >/dev/null 2>&1; then
                pwsh -NoProfile -ExecutionPolicy Bypass -File "$checker" -Path "$f" || rc=1
            elif command -v powershell >/dev/null 2>&1; then
                powershell -NoProfile -ExecutionPolicy Bypass -File "$checker" -Path "$f" || rc=1
            fi
        done
        exit $rc
        ;;
    *.sh)
        sh "$checker" $files
        exit $?
        ;;
esac

echo "⚠️  没找到可用的 PowerShell，跳过脱敏检查" >&2
exit 0
