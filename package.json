{
  "name": "agent-development-constraints",
  "version": "0.26.3",
  "description": "Self-evolving development constraints for AI coding agents — installs a rule library and injects it into every step.",
  "keywords": [
    "ai",
    "agent",
    "agents-md",
    "claude",
    "cursor",
    "constraints",
    "rules",
    "conventions",
    "code-review",
    "lessons-learned",
    "dsh-plugin"
  ],
  "license": "MIT",
  "bin": {
    "agent-constraints": "bin/cli.js",
    "adc": "bin/cli.js"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "comment:zero-deps": "刻意不声明任何 @deepseek-ai/* 依赖：profile 里配了 autoInstallPeers:false，peer 依赖不会被安装，顶层 import 会直接让插件加载失败并拖垮宿主会话。见 index.mjs 文件头的「错误 1」。",
  "files": [
    "index.mjs",
    "dsh/",
    "cordis.patch.yml",
    "bin/",
    "core/",
    "templates/",
    "examples/",
    "scripts/",
    ".githooks/",
    ".sanitize-deny.txt",
    "install.ps1",
    "install.sh",
    "contribute.ps1",
    "contribute.sh",
    "README.md",
    "README.zh-CN.md",
    "PRIVACY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "VERSION",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/962599627/agent-development-constraints.git"
  },
  "homepage": "https://github.com/962599627/agent-development-constraints#readme",
  "bugs": {
    "url": "https://github.com/962599627/agent-development-constraints/issues"
  },
  "scripts": {
    "test": "node tests/plugin.spec.mjs"
  }
}
