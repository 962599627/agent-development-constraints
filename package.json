{
  "name": "agent-development-constraints",
  "version": "0.8.0",
  "description": "Self-evolving development constraints for AI coding agents — installs a rule library and injects it into every step.",
  "keywords": [
    "ai",
    "agent",
    "agents-md",
    "claude",
    "cursor",
    "constraints",
    "rules",
    "conventions",
    "code-review",
    "lessons-learned",
    "dsh-plugin"
  ],
  "license": "MIT",
  "bin": {
    "agent-constraints": "bin/cli.js",
    "adc": "bin/cli.js"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "bin/",
    "core/",
    "templates/",
    "examples/",
    "scripts/",
    ".githooks/",
    ".sanitize-deny.txt",
    "install.ps1",
    "install.sh",
    "contribute.ps1",
    "contribute.sh",
    "README.md",
    "README.zh-CN.md",
    "PRIVACY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "VERSION",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/962599627/agent-development-constraints.git"
  },
  "homepage": "https://github.com/962599627/agent-development-constraints#readme",
  "bugs": {
    "url": "https://github.com/962599627/agent-development-constraints/issues"
  },
  "scripts": {
    "test": "node tests/plugin.spec.mjs"
  }
}
